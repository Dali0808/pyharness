# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type checker, linter, and formatter caches
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# Build and packaging artifacts
build/
dist/
*.egg-info/

# Local configuration and secrets
.env
.env.*
!.env.example

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local runtime artifacts
.runtime/
.eval/
*.log
