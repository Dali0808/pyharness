# Copy to .env; chmod 600 .env. Do not commit keys or use the example host as-is.
LARIO_IMAGE=ghcr.io/YOUR_OWNER/YOUR_REPO:sha-REPLACE_WITH_40_CHARACTER_COMMIT
LARIO_DOMAIN=assistant.example.com
LARIO_PUBLIC_URL=https://assistant.example.com
LARIO_MODEL=deepseek-chat
LARIO_MODEL_BASE_URL=https://api.deepseek.com/v1
LARIO_API_KEY_ENV=DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=REPLACE_ON_SERVER
LARIO_CONTEXT_WINDOW=64000
LARIO_MAX_STEPS=20
LARIO_DAILY_REQUESTS=200
LARIO_DAILY_TOKENS=1000000
# 2-core/2GB starter: one active task; increase only after measuring memory.
LARIO_CONCURRENT_RUNS=1
LARIO_MAX_FILE_BYTES=1000000
LARIO_STORAGE_BYTES=50000000
LARIO_MAX_FILES=200
